# Copia este archivo como .env y llena tus valores (el .env NO se sube a GitHub)

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=jobmatch

# Tokens de sesión (genera uno con: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Login
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=15

# El backend sirve también las páginas: con uvicorn encendido abre http://127.0.0.1:8000
SERVE_FRONTEND=true
# Dirección donde se abren las páginas (para el enlace del correo de recuperación)
FRONTEND_URL=http://127.0.0.1:8000
# Solo si abres las páginas con Live Server (puerto 5500): orígenes que pueden llamar a la API
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
RESET_TOKEN_MINUTES=30

# Correo SMTP (opcional). Si SMTP_HOST queda vacío, el enlace de recuperación
# se imprime en la consola de uvicorn (útil en desarrollo).
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Empléate Jobmatch <no-reply@empleate.local>
SMTP_USE_TLS=true

# Archivos
MAX_CV_MB=5
# Segundos máximos de espera a la IA
AI_TIMEOUT_SECONDS=60

# IA para leer hojas de vida: claude | openai | none
# Con "none" (o sin clave) se usa el lector básico por reglas.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
